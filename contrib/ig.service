# systemd user unit. Install as ~/.config/systemd/user/ig.service, then:
#
#   systemctl --user daemon-reload
#   systemctl --user enable --now ig
#   journalctl --user -u ig -f
#
# `loginctl enable-linger $USER` keeps it running when you are not logged in.

[Unit]
Description=ig
Documentation=https://github.com/Lincyaw/ig
After=network-online.target
Wants=network-online.target

[Service]
# Type=simple, not forking: ig stays in the foreground on purpose, so systemd
# tracks the process it started rather than guessing at a pidfile.
Type=simple
ExecStart=/usr/local/bin/ig daemon --service %h/.config/ig/services.toml

# A laptop lid, a changed network, a relay hiccup: iroh reconnects on its own,
# so a restart here is for the daemon actually dying.
Restart=always
RestartSec=5

# Logs go to the journal, which rotates. Redirecting to a file does not.
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
